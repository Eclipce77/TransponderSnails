{
  "multipart": [
    {
      "comment": "Center dot - always rendered",
      "apply": { "model": "transpondersnails:block/wire_dot" }
    },
    {
      "comment": "North horizontal connection",
      "when": { "north": true },
      "apply": { "model": "transpondersnails:block/wire_side", "y": 0 }
    },
    {
      "comment": "South horizontal connection",
      "when": { "south": true },
      "apply": { "model": "transpondersnails:block/wire_side", "y": 180 }
    },
    {
      "comment": "East horizontal connection",
      "when": { "east": true },
      "apply": { "model": "transpondersnails:block/wire_side", "y": 90 }
    },
    {
      "comment": "West horizontal connection",
      "when": { "west": true },
      "apply": { "model": "transpondersnails:block/wire_side", "y": 270 }
    },
    {
      "comment": "North vertical up connection",
      "when": { "up_north": true },
      "apply": { "model": "transpondersnails:block/wire_side_up", "y": 0 }
    },
    {
      "comment": "South vertical up connection",
      "when": { "up_south": true },
      "apply": { "model": "transpondersnails:block/wire_side_up", "y": 180 }
    },
    {
      "comment": "East vertical up connection",
      "when": { "up_east": true },
      "apply": { "model": "transpondersnails:block/wire_side_up", "y": 90 }
    },
    {
      "comment": "West vertical up connection",
      "when": { "up_west": true },
      "apply": { "model": "transpondersnails:block/wire_side_up", "y": 270 }
    }
  ]
}